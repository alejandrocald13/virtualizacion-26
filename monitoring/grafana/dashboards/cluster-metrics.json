{
  "uid": "cluster-metrics",
  "title": "Cluster Metrics",
  "tags": ["racm", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Node CPU usage",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Node memory usage",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Running pods",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(kube_pod_status_phase{phase=\"Running\"})"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Pods not running",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"})"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage by namespace",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\", image!=\"\"}[5m]))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory usage by namespace",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_memory_working_set_bytes{container!=\"\", image!=\"\"})",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage by pod (parcial-racm)",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"parcial-racm\", container!=\"\", image!=\"\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "cores"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory usage by pod (parcial-racm)",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"parcial-racm\", container!=\"\", image!=\"\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Pods by phase",
      "gridPos": {"x": 0, "y": 20, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (phase) (kube_pod_status_phase)",
          "legendFormat": "{{phase}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Pod status",
      "gridPos": {"x": 8, "y": 20, "w": 16, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (namespace, pod, phase) (kube_pod_status_phase{namespace=~\"parcial-racm|monitoring-racm|traefik\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true}}}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Available replicas (parcial-racm)",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{namespace=\"parcial-racm\"}",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Container restarts",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, pod) (kube_pod_container_status_restarts_total{namespace=~\"parcial-racm|monitoring-racm|traefik\"})",
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ]
    }
  ]
}
